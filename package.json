{
  "name": "tun",
  "version": "0.1.0",
  "private": true,
  "description": "Developer-first device quality and evaluation platform",
  "type": "module",
  "homepage": "https://github.com/zerogravit1/tun#readme",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerogravit1/tun.git"
  },
  "author": "Jonathan Schaffer",
  "scripts": {
    "dev": "tsx src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
